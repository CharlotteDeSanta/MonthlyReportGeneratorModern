<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="MonthlyReportGeneratorModern.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dg="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:local="using:MonthlyReportGeneratorModern">
    <Application.Resources>
        <ResourceDictionary>
            <!--
              覆盖 CommunityToolkit DataGrid 默认（银灰旧样式）的选中/编辑高亮为现代 Fluent 配色：
              行选中 = 主题蓝浅染（Win11 ListView 风格）、悬停 = 中性灰、
              未聚焦选中 = 中性灰浅染、编辑焦点框 = 主题蓝。
              键名来自包内主题资源（DataGridRowSelectedBackgroundColor 等，ThemeResource 机制，应用层可覆盖）。
              详见 MIGRATION.md 坑 16。
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="DataGridRowHoveredBackgroundColor">#F5F5F5</Color>
                    <Color x:Key="DataGridRowSelectedBackgroundColor">#0F6CBD</Color>
                    <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">0.30</x:Double>
                    <Color x:Key="DataGridRowSelectedHoveredBackgroundColor">#0F6CBD</Color>
                    <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">0.40</x:Double>
                    <Color x:Key="DataGridRowSelectedUnfocusedBackgroundColor">#7A7A7A</Color>
                    <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">0.30</x:Double>
                    <Color x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundColor">#7A7A7A</Color>
                    <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">0.40</x:Double>
                    <Color x:Key="DataGridColumnHeaderHoveredBackgroundColor">#F0F0F0</Color>
                    <Color x:Key="DataGridColumnHeaderPressedBackgroundColor">#E0E0E0</Color>
                    <SolidColorBrush x:Key="DataGridCellFocusVisualPrimaryBrush" Color="#0F6CBD" />
                    <SolidColorBrush x:Key="DataGridCellFocusVisualSecondaryBrush" Color="#FFFFFF" />
                    <!-- 文本框聚焦边框：WinUI 3 默认纯黑，改为主题蓝 -->
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#0F6CBD" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="DataGridRowHoveredBackgroundColor">#3D3D3D</Color>
                    <Color x:Key="DataGridRowSelectedBackgroundColor">#60CDFF</Color>
                    <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">0.30</x:Double>
                    <Color x:Key="DataGridRowSelectedHoveredBackgroundColor">#60CDFF</Color>
                    <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">0.40</x:Double>
                    <Color x:Key="DataGridRowSelectedUnfocusedBackgroundColor">#8A8A8A</Color>
                    <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">0.30</x:Double>
                    <Color x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundColor">#8A8A8A</Color>
                    <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">0.40</x:Double>
                    <Color x:Key="DataGridColumnHeaderHoveredBackgroundColor">#3A3A3A</Color>
                    <Color x:Key="DataGridColumnHeaderPressedBackgroundColor">#2E2E2E</Color>
                    <SolidColorBrush x:Key="DataGridCellFocusVisualPrimaryBrush" Color="#60CDFF" />
                    <SolidColorBrush x:Key="DataGridCellFocusVisualSecondaryBrush" Color="#FF1F1F1F" />
                    <!-- 文本框聚焦边框：WinUI 3 暗色主题默认纯白，改为暗色主题强调蓝 -->
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#60CDFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!--
              无边框单元格模板（MIGRATION.md 坑18）：默认 DataGridCell 模板里的 FocusVisual 矩形
              以 BorderBrush 描边（默认黑）显示编辑焦点框，重写模板只保留 ContentPresenter，
              彻底移除编辑态黑色包边（行选中/休息日高亮在行级，不受影响）。
              注意（坑19）：ContentPresenter 必须 HorizontalAlignment=Stretch（编辑框才撑满列宽、
              随窗口缩放同步）且 Background=Transparent（空文本单元格才有命中区域，否则点击穿透、
              无法进入编辑态）。
            -->
            <Style x:Key="BorderlessDataGridCellStyle" TargetType="dg:DataGridCell">
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="dg:DataGridCell">
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                Margin="{TemplateBinding Padding}"
                                Background="Transparent"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 编辑态文本框去边框（DataGridTextColumn 的 EditingElementStyle 使用） -->
            <Style x:Key="BorderlessTextBoxStyle" TargetType="TextBox">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
            </Style>

            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!-- Other app resources here -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
