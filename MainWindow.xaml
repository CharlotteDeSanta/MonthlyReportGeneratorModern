<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MonthlyReportGeneratorModern.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MonthlyReportGenerator.ViewModels"
    xmlns:views="using:MonthlyReportGeneratorModern.Views"
    Title="科烽智能AGV月报生成工具">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏（拖拽区，代码里 SetTitleBar） -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" Spacing="8">
                <Image Source="/Assets/app.png" Width="18" Height="18" />
                <TextBlock Text="科烽智能AGV月报生成工具" VerticalAlignment="Center" FontSize="13" />
            </StackPanel>
        </Grid>

        <!-- 公共区：姓名/等级（三页共享，变更即持久化） -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,4,12,8" Spacing="6">
            <TextBlock Text="姓名" VerticalAlignment="Center" />
            <TextBox Width="110"
                     Text="{Binding Profile.EmployeeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="工程师等级" VerticalAlignment="Center" Margin="12,0,0,0" />
            <ComboBox Width="130"
                      ItemsSource="{Binding Profile.Levels}"
                      SelectedItem="{Binding Profile.Level, Mode=TwoWay}" />
        </StackPanel>

        <!-- 标签（SelectorBar） -->
        <SelectorBar x:Name="TabBar" Grid.Row="2" Margin="12,0,12,8" SelectionChanged="OnTabSelectionChanged">
            <SelectorBarItem Text="月报" IsSelected="True" />
            <SelectorBarItem Text="日报" />
            <SelectorBarItem Text="周报" />
        </SelectorBar>

        <!-- 三个页面视图常驻（仅切换 Visibility，避免每次切换重建视觉树；
             DataContext/Visibility 由代码隐藏管理——WinUI 3 中 ElementName 绑定不可靠） -->
        <Grid Grid.Row="3" Margin="12,0,12,12">
            <views:MonthlyReportView x:Name="MonthlyView" />
            <views:DailyReportView x:Name="DailyView" Visibility="Collapsed" />
            <views:WeeklyReportView x:Name="WeeklyView" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
