<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MonthlyReportGeneratorModern.Views.WeeklyReportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 元信息区（未完成项与填表日期换行显示） -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="年份" VerticalAlignment="Center" />
                <ComboBox Width="90" ItemsSource="{Binding Years}" SelectedItem="{Binding Year, Mode=TwoWay}" />
                <TextBlock Text="周数" VerticalAlignment="Center" Margin="6,0,0,0" />
                <ComboBox Width="80" ItemsSource="{Binding Weeks}" SelectedItem="{Binding Week, Mode=TwoWay}" />
                <TextBlock Text="{Binding WeekRangeText}" VerticalAlignment="Center" FontWeight="Bold" Margin="6,0,0,0" />
                <TextBlock Text="项目名称" VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBox Width="160" Text="{Binding Meta.ProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="填写人" VerticalAlignment="Center" Margin="6,0,0,0" />
                <TextBox Width="100" Text="{Binding Meta.Writer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="是否按上周计划完成" VerticalAlignment="Center" Margin="6,0,0,0" />
                <ComboBox Width="64" ItemsSource="{Binding YesNoOptions}"
                          SelectedItem="{Binding FollowedLastPlanText, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                <TextBlock Text="未完成项" VerticalAlignment="Center" />
                <TextBox Width="260" Text="{Binding Meta.Unfinished, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="填表日期" VerticalAlignment="Center" Margin="6,0,0,0" />
                <TextBlock Text="{Binding ReportDateText}" VerticalAlignment="Center" Margin="6,0,0,0" FontWeight="Bold" />
            </StackPanel>
        </StackPanel>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8" Spacing="8">
            <Button Content="导出 XLSX" Style="{StaticResource AccentButtonStyle}" Command="{Binding ExportCommand}" />
            <Button Content="清空表单" Command="{Binding ClearCommand}" />
        </StackPanel>

        <!-- 本周/下周明细 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="本周工作总结" FontWeight="Bold" Margin="0,0,0,4" />
                <controls:DataGrid ItemsSource="{Binding ThisWeek}"
                                   AutoGenerateColumns="False"
                                   CanUserSortColumns="False"
                                   CanUserReorderColumns="False"
                                   HeadersVisibility="Column"
                                   GridLinesVisibility="All"
                                   SelectionMode="Single"
                                   RowHeight="42"
                                   Height="340"
                                   PointerPressed="OnGridPointerPressed">
                    <controls:DataGrid.Columns>
                        <controls:DataGridTextColumn Header="星期" IsReadOnly="True" Width="100"
                                                     Binding="{Binding DateDisplay, Mode=OneWay}" />
                        <controls:DataGridTextColumn Header="类别" Width="90"
                                                     Binding="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <controls:DataGridTemplateColumn Header="工作内容" Width="3*">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Content, Mode=OneWay}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Margin="2,0" />
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                            <controls:DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="40" />
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellEditingTemplate>
                        </controls:DataGridTemplateColumn>
                        <controls:DataGridTextColumn Header="阶段要点" Width="140"
                                                     Binding="{Binding StagePoints, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <controls:DataGridTextColumn Header="需要协调的内容" Width="140"
                                                     Binding="{Binding Coordination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <controls:DataGridTextColumn Header="计划完成时间" Width="100"
                                                     Binding="{Binding PlanFinishDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <controls:DataGridTextColumn Header="进度状态" Width="80"
                                                     Binding="{Binding Progress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <controls:DataGridTextColumn Header="备注" Width="110"
                                                     Binding="{Binding Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:DataGrid.Columns>
                </controls:DataGrid>

                <TextBlock Text="下周工作计划" FontWeight="Bold" Margin="0,12,0,4" />
                <controls:DataGrid ItemsSource="{Binding NextWeek}"
                                   AutoGenerateColumns="False"
                                   CanUserSortColumns="False"
                                   CanUserReorderColumns="False"
                                   HeadersVisibility="Column"
                                   GridLinesVisibility="All"
                                   SelectionMode="Single"
                                   RowHeight="42"
                                   Height="340"
                                   PointerPressed="OnGridPointerPressed">
                    <controls:DataGrid.Columns>
                        <controls:DataGridTextColumn Header="星期" IsReadOnly="True" Width="100"
                                                     Binding="{Binding DateDisplay, Mode=OneWay}" />
                        <controls:DataGridTextColumn Header="类别" Width="90"
                                                     Binding="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <controls:DataGridTemplateColumn Header="工作内容" Width="3*">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Content, Mode=OneWay}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Margin="2,0" />
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                            <controls:DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="40" />
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellEditingTemplate>
                        </controls:DataGridTemplateColumn>
                        <controls:DataGridTextColumn Header="阶段要点" Width="140"
                                                     Binding="{Binding StagePoints, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <controls:DataGridTextColumn Header="需要协调的内容" Width="140"
                                                     Binding="{Binding Coordination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <controls:DataGridTextColumn Header="计划完成时间" Width="100"
                                                     Binding="{Binding PlanFinishDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <controls:DataGridTextColumn Header="进度状态" Width="80"
                                                     Binding="{Binding Progress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <controls:DataGridTextColumn Header="备注" Width="110"
                                                     Binding="{Binding Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:DataGrid.Columns>
                </controls:DataGrid>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Text="{Binding NoticeText}" Foreground="#E8A33D" Margin="0,6,0,0" />
    </Grid>
</UserControl>
